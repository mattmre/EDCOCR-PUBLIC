      "configure": "^(ocr_.*|cpu_.*|nlp_.*|coordinator|celery.*|amq\\..*|.*\\.pidbox|celeryev.*|celery\\.pidbox)$",
      "write": "^(celery.*|.*\\.pidbox|celeryev.*|celery\\.pidbox|amq\\..*)$",
      "read": "^(ocr_.*|cpu_.*|nlp_.*|coordinator|celery.*|amq\\..*|.*\\.pidbox|celeryev.*|celery\\.pidbox)$"
