      "tags": [
        "administrator"
      ]
    },
    {
      "name": "ocr_publisher",
      "password_hash": "",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": [
        "management"
      ]
    },
    {
      "name": "ocr_worker",
      "password_hash": "",
