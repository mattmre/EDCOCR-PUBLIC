# Worker node with GPU support and air-gapped model pre-bake
# All OCR models are baked into the image at build time for
# deployment in air-gapped (no internet) environments.

FROM python:3.12-slim-bookworm AS base
ARG SOURCE_REVISION
ARG SOURCE_TREE_SHA256
RUN if ! printf '%s' "${SOURCE_REVISION}" | grep -Eq '^[0-9a-f]{40,64}$' || \
       ! printf '%s' "${SOURCE_TREE_SHA256}" | grep -Eq '^[0-9a-f]{64}$'; then \
      printf '%s\n' 'ERROR: use scripts/with_runtime_source.sh worker to build this image' >&2; exit 1; fi
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}" \
      io.ocr_local.runtime-source-sha256="${SOURCE_TREE_SHA256}" \
      io.ocr_local.runtime-profile="worker"

# System dependencies for OCR
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr-all \
    poppler-utils \
    ghostscript \
    fonts-noto-core \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libzbar0 \
    nfs-common \
    tini \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Noto Sans fonts for searchable-PDF text layer embedding (font_selector.py)
# ---------------------------------------------------------------------------
# Symlink non-CJK fonts installed by fonts-noto-core into the app font dir.
RUN mkdir -p /app/fonts/noto && \
    for f in \
        NotoSans-Regular.ttf \
        NotoSansArabic-Regular.ttf \
        NotoSansDevanagari-Regular.ttf \
        NotoSansTamil-Regular.ttf \
        NotoSansTelugu-Regular.ttf \
        NotoSansKannada-Regular.ttf \
        NotoSansGeorgian-Regular.ttf \
        NotoSansThai-Regular.ttf \
        NotoSansBengali-Regular.ttf; \
    do \
        [ -f "/usr/share/fonts/truetype/noto/$f" ] && \
            ln -sf "/usr/share/fonts/truetype/noto/$f" "/app/fonts/noto/$f"; \
    done

# Download individual CJK OTF files (the Debian fonts-noto-cjk package only
# provides a .ttc collection, not individual .otf files needed by font_selector).
# Air-gapped deployment: pre-stage these files in a local fonts/ directory and
# replace the curl commands below with:
#   COPY fonts/NotoSansCJK*.otf /app/fonts/noto/
RUN curl -fSL "https://github.com/notofonts/noto-cjk/raw/f8d157532fbfaeda587e826d4cd5b21a49186f7c/Sans/OTF/SimplifiedChinese/NotoSansCJKsc-Regular.otf" \
         -o /app/fonts/noto/NotoSansCJKsc-Regular.otf && \
    curl -fSL "https://github.com/notofonts/noto-cjk/raw/f8d157532fbfaeda587e826d4cd5b21a49186f7c/Sans/OTF/TraditionalChinese/NotoSansCJKtc-Regular.otf" \
         -o /app/fonts/noto/NotoSansCJKtc-Regular.otf && \
    curl -fSL "https://github.com/notofonts/noto-cjk/raw/f8d157532fbfaeda587e826d4cd5b21a49186f7c/Sans/OTF/Japanese/NotoSansCJKjp-Regular.otf" \
         -o /app/fonts/noto/NotoSansCJKjp-Regular.otf && \
    curl -fSL "https://github.com/notofonts/noto-cjk/raw/f8d157532fbfaeda587e826d4cd5b21a49186f7c/Sans/OTF/Korean/NotoSansCJKkr-Regular.otf" \
         -o /app/fonts/noto/NotoSansCJKkr-Regular.otf

WORKDIR /app

# PaddleOCR 2.9.1 resolves caches from $HOME/.paddleocr, not
# PADDLEOCR_HOME. Use the final non-root user's home during model preload.
ENV HOME=/home/ocr
ENV PADDLE_HOME=/home/ocr/.paddle
ENV PADDLEOCR_HOME=/home/ocr/.paddleocr
RUN mkdir -p /home/ocr/.paddle /home/ocr/.paddleocr

# Install requirements
COPY coordinator/requirements.txt /app/coordinator-requirements.txt
COPY requirements.txt /app/ocr-requirements.txt
RUN python3 -m pip install --no-cache-dir --upgrade "pip==26.2.1"
RUN pip install --no-cache-dir -r /app/coordinator-requirements.txt -r /app/ocr-requirements.txt

COPY scripts/harden_imgaug_runtime.py /tmp/harden_imgaug_runtime.py
RUN python3 /tmp/harden_imgaug_runtime.py && rm /tmp/harden_imgaug_runtime.py

# Pre-bake the 32 PaddleOCR 2.9.1-native core language entries.
# --cpu-only forces use_gpu=False with CUDA visibility disabled. Preload keeps
# native Paddle model format; freshly downloaded caches are not ONNX models.
# SKIP_MODEL_PRELOAD=1 skips download entirely (escape hatch).
COPY download_models.py /tmp/download_models.py
ARG SKIP_MODEL_PRELOAD=0
RUN SKIP_MODEL_PRELOAD=${SKIP_MODEL_PRELOAD} \
    python3 /tmp/download_models.py --cpu-only \
    && rm /tmp/download_models.py

# Pre-bake FastText language identification model (126MB)
RUN mkdir -p /app/models && \
    curl -fSL "https://dl.fbaipublicfiles.com/fasttext/supervised-models/lid.176.bin" \
         -o /app/models/lid.176.bin
ENV FASTTEXT_MODEL_PATH=/app/models/lid.176.bin

# Pre-bake spaCy NER model (en_core_web_sm) for air-gapped entity extraction
# Fail closed at build if model cannot load offline after install.
RUN python3 -m spacy download en_core_web_sm &&     python3 -c "import spacy; spacy.load('en_core_web_sm'); print('SPACY_BAKE_OK')"

# Copy application code
COPY . /app/

ENV PYTHONPATH=/app:/app/coordinator
ENV DJANGO_SETTINGS_MODULE=coordinator.settings

# ---------------------------------------------------------------------------
# Remove build-essential from runtime image (maintenance review / INFRA-002)
# gcc/g++/make are only needed for compiling C extensions during pip install;
# the compiled .so files remain but the toolchain is stripped to reduce
# image size (~200MB) and CVE surface area.
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get purge -y --auto-remove build-essential && \
    rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Non-root runtime user (SEC-003)
# ---------------------------------------------------------------------------
RUN groupadd -r -g 1000 ocr && \
    useradd -r -u 1000 -g ocr -d /home/ocr -s /sbin/nologin ocr && \
    mkdir -p /home/ocr && \
    chown -R ocr:ocr /home/ocr

USER ocr

# ---------------------------------------------------------------------------
# Docker HEALTHCHECK — Celery worker inspect ping (maintenance review)
# start-period=120s gives time for PaddleOCR model loading.
# ---------------------------------------------------------------------------
HEALTHCHECK --interval=30s --timeout=15s --start-period=120s --retries=3 \
    CMD python3 /app/coordinator/worker_healthcheck.py

# Default: general worker also consumes the structured-extraction chord queue.
ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
CMD ["celery", "-A", "coordinator", "worker", \
     "-Q", "ocr_gpu,cpu_general,nlp_general", \
     "-c", "4", \
     "--hostname", "worker@%h", \
     "-l", "info"]
