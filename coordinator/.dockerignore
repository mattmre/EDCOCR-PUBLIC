# =============================================================================
# .dockerignore - Coordinator build context
# =============================================================================
# Legacy direct coordinator-directory context exclusions.
# Canonical builds use the repository-root context and the root .dockerignore
# because jobs.tasks imports shared ocr_distributed/ocr_local source.
# =============================================================================

# -- Version control ----------------------------------------------------------
.git/
.gitignore

# -- Tests / dev fixtures -----------------------------------------------------
conftest.py
pytest.ini
__pycache__/
*.pyc
.pytest_cache/
.coverage
coverage.xml

# -- Docker build files (already consumed, not needed in image) ---------------
Dockerfile.*
docker-compose*.yml

# -- Secrets / environment (must not be baked into images) --------------------
.env

# -- Editor / IDE -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# -- Documentation ------------------------------------------------------------
*.md
