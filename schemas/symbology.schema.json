{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ocr-local.dev/schemas/symbology.schema.json",
  "title": "Symbology Detection Output",
  "description": "Barcode, QR-code, and optical-mark detection sidecar written under EXPORT/SYMBOLOGY.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "document_id", "source_file", "processing", "summary", "pages"],
  "properties": {
    "schema_version": {"type": "string"},
    "document_id": {"type": "string"},
    "source_file": {"type": "string"},
    "processing": {
      "type": "object",
      "additionalProperties": true,
      "required": ["detection_engines", "pipeline_version", "timestamp"],
      "properties": {
        "detection_engines": {"type": "string"},
        "pipeline_version": {"type": "string"},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["total_barcodes", "total_marks", "checked_marks", "unchecked_marks", "barcode_types_found"],
      "properties": {
        "total_barcodes": {"type": "integer", "minimum": 0},
        "total_marks": {"type": "integer", "minimum": 0},
        "checked_marks": {"type": "integer", "minimum": 0},
        "unchecked_marks": {"type": "integer", "minimum": 0},
        "barcode_types_found": {"type": "array", "items": {"type": "string"}}
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["page_num", "barcodes", "marks", "total_barcodes", "total_marks", "checked_marks"],
        "properties": {
          "page_num": {"type": "integer", "minimum": 1},
          "barcodes": {"type": "array", "items": {"type": "object"}},
          "marks": {"type": "array", "items": {"type": "object"}},
          "total_barcodes": {"type": "integer", "minimum": 0},
          "total_marks": {"type": "integer", "minimum": 0},
          "checked_marks": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
